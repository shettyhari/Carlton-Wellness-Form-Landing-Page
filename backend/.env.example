# Copy this file to .env and fill in the values. Never commit .env.

PORT=4000

# ---- Frontend ----
# Serve the landing page from this server (true) or host it separately (false)
SERVE_FRONTEND=true
# Only needed if the frontend is on a different domain, comma-separated
# CORS_ORIGINS=https://franchise.carltonwellnessgroup.com

# Meta Pixel ID, passed to the page when it is served from this server
META_PIXEL_ID=

# Set to false if the server is NOT behind Nginx or a hosting proxy
TRUST_PROXY=true

# ---- Database ----
# Add the database settings here when the database is connected in src/leadStore.js
